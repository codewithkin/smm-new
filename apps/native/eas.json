{
  "cli": {
    "version": ">= 5.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "DATABASE_URL": "postgresql://postgres:postgres@localhost:5432/smart_switch"
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "DATABASE_URL": "postgresql://postgres:postgres@localhost:5432/smart_switch"
      }
    }
  },
  "submit": {
    "production": {}
  }
}