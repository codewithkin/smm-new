{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs"
  },
  "dependencies": {
    "@smart-switch-mobile/db": "workspace:*",
    "@smart-switch-mobile/env": "workspace:*",
    "dotenv": "catalog:",
    "hono": "^4.12.32",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@smart-switch-mobile/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  }
}
